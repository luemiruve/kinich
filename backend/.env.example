# Copia este archivo como backend/.env y rellena los valores. Nunca subas .env al repositorio.

KINICH_DB_URL=jdbc:postgresql://localhost:5432/kinich_dev
KINICH_DB_USERNAME=kinich
KINICH_DB_PASSWORD=

# Base de datos para las pruebas de integración
KINICH_TEST_DB_URL=jdbc:postgresql://localhost:5432/kinich_test

# Clave HMAC del JWT en Base64, mínimo 256 bits. Generar con: openssl rand -base64 48
KINICH_JWT_SECRET=

# Solo en desarrollo local sobre http://localhost. En producción debe ser true (por defecto).
KINICH_COOKIE_SECURE=false

# Orígenes permitidos para CORS, separados por comas. El proxy de Vite reenvía la cabecera Origin,
# así que en desarrollo hay que permitir el origen del servidor de Vite.
KINICH_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cuenta de administración inicial: se crea solo si la tabla de usuarios está vacía.
# Contraseña de al menos 12 caracteres. Puedes borrarla de aquí tras el primer arranque.
KINICH_ADMIN_EMAIL=
KINICH_ADMIN_PASSWORD=
KINICH_ADMIN_FULL_NAME=

# Directorio de imágenes (ruta absoluta, fuera del repositorio y de cualquier carpeta servida por la web).
# Debe existir y ser escribible por el backend. La aplicación no arranca sin él.
KINICH_MEDIA_DIR=

# Procesamiento de imágenes: requiere libvips >= 8.13 con soporte AVIF instalado en el servidor.
# Opcionales: comando de libvips y directorio de trabajo privado (por defecto, el temporal del sistema).
# KINICH_VIPS_COMMAND=vips
# KINICH_MEDIA_WORK_DIR=
